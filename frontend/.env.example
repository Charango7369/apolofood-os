# ============================================================
# ApoloFoodOS — Frontend (Cloudflare Pages)
# Copiar como .env.local para desarrollo
# En Cloudflare Pages: configurar en Settings > Environment variables
# ============================================================

# URL del backend en Railway (sin slash final)
# Desarrollo: dejar vacío (Vite hace proxy automático a localhost:8000)
VITE_API_URL=

# Producción:
# VITE_API_URL=https://apolofood-production.up.railway.app

# ID del restaurante demo (cambiar por el real en producción)
VITE_RESTAURANTE_ID=rest-demo-001
