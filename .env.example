# ============================================================
# ApoloFoodOS — Backend (Railway)
# Copiar como .env para desarrollo local
# En Railway: configurar como variables de entorno en el dashboard
# ============================================================

# App
DEBUG=false
SECRET_KEY=genera-uno-con-openssl-rand-hex-32

# Base de datos
# Desarrollo local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./apolofood.db
# Producción (Railway PostgreSQL o Neon.tech):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/apolofood

# CORS — separar por coma, sin espacios
# Agregar la URL de tu Cloudflare Pages cuando la tengas
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://apolofood.pages.dev

# Twilio WhatsApp (dejar vacío en dev → mock automático)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Cloudflare R2 (opcional)
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=apolofood-images
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
